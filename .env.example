# Template only — copy to `.env.local` for your machine (never commit secrets).
#
# Local:  cp .env.example .env.local   (or copy manually on Windows)
# Prod:   do NOT create .env in the repo. Set the same keys on the VM / host
#         environment (or secrets manager) when you deploy.

# Deployment profile: dev (default) | prod (enforces docker + allowlist + no host CLI fallback)
# ROCKY_PROFILE=dev
# ROCKY_INSTANCE_ID=local
# Prod example:
# ROCKY_PROFILE=prod
# ROCKY_INSTANCE_ID=sg1
# ROCKY_OPENCLAW_RUNTIME=docker
# ROCKY_ALLOW_FROM=15550001111,15550002222
# ROCKY_CLI_HOST_FALLBACK=0

# Gateway
ROCKY_PORT=8787
# Cloud hosts often inject PORT — we honor PORT first, then ROCKY_PORT.
ROCKY_CHANNEL=twilio
ROCKY_SHARED_NUMBER=+15551234567

# Persistent roots. Production should place both outside the application image.
# The organization bundle is mounted read-only into tenant containers.
# ROCKY_TENANTS_DIR=/srv/rocky/tenants
# ROCKY_ORG_DIR=/srv/rocky/org
# ROCKY_PLATFORM_DIR=/srv/rocky/platform

# Admin HTTP APIs (/api/tenants, /api/signup, mock /api/dev/message)
# Required. Send as: Authorization: Bearer <token>
ROCKY_API_TOKEN=change-me-to-a-long-random-secret

# Encrypts tenant vault records at rest. Required in production; must decode to
# exactly 32 bytes. Generate once, store in the deployment secret manager, and
# back it up separately. Example: openssl rand -base64 32
ROCKY_VAULT_MASTER_KEY=

# Internal connector-only sidecar. The Composio project key is configured via
# `tenant mcp configure --backend composio` on stdin; never place it here.
# ROCKY_CONNECTOR_SIDECAR_URL=http://127.0.0.1:4317
# ROCKY_ENTERPRISE_ORG_ID=buglerock

# Must be reachable from the phone browser for OAuth (ngrok locally; real domain in prod)
ROCKY_PUBLIC_BASE_URL=https://YOUR-TUNNEL.example

# Inbound queue
# ROCKY_INBOUND_COALESCE_MS=1500
# ROCKY_INBOUND_BUSY_ACK=true

# WhatsApp DM allowlist (comma-separated). Non-empty = only these phones; empty = open (unsafe on public tunnels).
# ROCKY_ALLOW_FROM=15550001111

# Per-tenant CLI homes — leave OFF (0) when any real phone is paired. ON only for solo local soak.
# ROCKY_CLI_HOST_FALLBACK=0

# Per-tenant warm OpenClaw Gateway (same code local + prod; tune with env)
# ROCKY_OPENCLAW_WARM=1
# ROCKY_OPENCLAW_RUNTIME=spawn
# Prod / real customers: ROCKY_OPENCLAW_RUNTIME=docker
# ROCKY_OPENCLAW_IMAGE=rocky-openclaw:2026.7.1-2
# ROCKY_OPENCLAW_DOCKER_MEMORY=2g
# ROCKY_OPENCLAW_DOCKER_CPUS=1
# ROCKY_OPENCLAW_GATEWAY_IDLE_MS=7200000
# ROCKY_OPENCLAW_GATEWAY_PORT_BASE=19100
# ROCKY_OPENCLAW_MAX_WARM=3
# Deprecated compatibility flag; Rocky never kills processes it does not own.
# ROCKY_OPENCLAW_KILL_FOREIGN=0

# Optional logout webhook
# ROCKY_LOGOUT_WEBHOOK_URL=

# Models
# ROCKY_CLAUDE_MODEL=anthropic/claude-haiku-4-5
# ROCKY_CODEX_MODEL=openai/gpt-5.4

# Session idle (ms)
# ROCKY_SESSION_IDLE_TTL_MS=10800000
# ROCKY_OPERATOR_SESSION_IDLE_TTL_MS=86400000
# Direct-message session reset after inactivity; default 43200 minutes (30 days).
# ROCKY_SESSION_RESET_IDLE_MINUTES=43200

# Speech (Sarvam) — one firm-owned subscription key, never a tenant credential.
# Absent: voice notes are recorded untranscribed. There is no local fallback.
SARVAM_API_KEY=
