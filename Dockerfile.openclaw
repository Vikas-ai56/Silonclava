FROM node:22-bookworm-slim

# Minimal OS deps for OpenClaw / Claude CLI
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git bash \
  && rm -rf /var/lib/apt/lists/*

# Pin OpenClaw to match common host installs; override at build with --build-arg
ARG OPENCLAW_VERSION=2026.7.1-2
# The paths the entrypoint creates and reads. The host asserts these against
# `container-paths.mjs` before it runs a container, so the two ends of the
# contract can never drift apart silently again (they did: the image read
# /run/rift-input while the host mounted /run/rocky-input).
LABEL org.opencontainers.image.title="rocky-openclaw" \
      org.opencontainers.image.version="${OPENCLAW_VERSION}" \
      dev.rocky.contract.runtime-dir="/run/rocky" \
      dev.rocky.contract.mcp-input-dir="/run/rocky-input"
RUN npm install -g "openclaw@${OPENCLAW_VERSION}" \
  && npm install -g @anthropic-ai/claude-code \
  && npm cache clean --force

# Document toolchain for the tenant's synced docx/pdf/pptx/xlsx skills.
# Baked in so a turn never depends on a runtime npm/pip install.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip pandoc \
  && rm -rf /var/lib/apt/lists/* \
  && pip3 install --no-cache-dir --break-system-packages pypdf openpyxl \
  && npm install -g docx pptxgenjs exceljs pdfkit \
  && npm cache clean --force

ENV NODE_PATH=/usr/local/lib/node_modules

# Non-root user (uid matches common host developer mounts on Linux)
RUN useradd -m -u 10001 -s /bin/bash rocky \
  && mkdir -p /tenant \
  && chown -R rocky:rocky /tenant

COPY docker/openclaw/entrypoint.sh /entrypoint.sh
RUN tr -d '\r' < /entrypoint.sh > /tmp/entrypoint.sh \
  && mv /tmp/entrypoint.sh /entrypoint.sh \
  && chmod 755 /entrypoint.sh

USER rocky
WORKDIR /tenant

ENV OPENCLAW_STATE_DIR=/tenant/openclaw \
    OPENCLAW_CONFIG_PATH=/tenant/openclaw/openclaw.json \
    OPENCLAW_WORKSPACE_DIR=/tenant/workspace \
    OPENCLAW_HOME=/tenant/openclaw \
    CLAUDE_CONFIG_DIR=/tenant/cli-home/claude \
    CODEX_HOME=/tenant/cli-home/codex \
    HOME=/home/rocky

EXPOSE 18789

ENTRYPOINT ["/entrypoint.sh"]
# Default overridden by Rocky: gateway run --port … --bind lan --auth token --token …
CMD ["gateway", "run", "--bind", "lan"]
